# LLM Dashboard environment variables
# Copy to .env and adjust as needed.

# Mode: auto | retrieval | openai | openai_compatible
LLM_MODE=auto

# Shared model name for LLM calls.
# OpenAI example: gpt-5.4-mini
# Ollama example: qwen2.5:7b
LLM_MODEL=gpt-5.4-mini

# OpenAI settings (used in openai mode, or as defaults in auto mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60

# OpenAI-compatible endpoint settings (used in openai_compatible mode)
# OpenAI default endpoint:
LLM_BASE_URL=https://api.openai.com/v1
# For Ollama, you can use:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# For NVIDIA NIM (OpenAI-compatible), you can use:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# API key for OpenAI-compatible endpoints.
# For Ollama, this is usually empty.
# For NVIDIA NIM, set your NVIDIA API key.
LLM_API_KEY=

# NVIDIA (OpenAI-compatible) quick example:
# LLM_MODE=openai_compatible
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxx
